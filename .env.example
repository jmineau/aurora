# ── Twilio (optional) ─────────────────────────────────────────────────────────
# Get these from https://console.twilio.com.  Set all three to send SMS, or
# leave all three blank to run collect-only (snapshots logged, no texts).
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# ── Scheduling ────────────────────────────────────────────────────────────────
CHECK_INTERVAL_MINUTES=30
ALERT_COOLDOWN_HOURS=6

# Validate X-Twilio-Signature on the /sms/inbound webhook. Set to true in
# production (the webhook writes to the DB from a public URL).
TWILIO_VALIDATE_SIGNATURE=false

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///aurora.db

# ── External API keys ─────────────────────────────────────────────────────────
# Free key from https://portal.opentopography.org/requestApiKey
OPENTOPOGRAPHY_API_KEY=

# ── Factor weights (exponents in the weighted-product visibility model) ───────
# 1.0 = linear;  >1 = harsher penalty;  0.0 = disable factor entirely
WEIGHT_OVATION=1.0
WEIGHT_KP=0.5
WEIGHT_CLOUD=1.5
WEIGHT_AOD=1.0
WEIGHT_ELEV=0.3
WEIGHT_MOON=0.5
WEIGHT_LP=0.5
WEIGHT_PWV=0.3
WEIGHT_HORIZ=0.5
