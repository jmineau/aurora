# ── Twilio (optional) ─────────────────────────────────────────────────────────
# Get these from https://console.twilio.com.  Set all three to send SMS, or
# leave all three blank to run collect-only (snapshots logged, no texts).
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# ── Garmin inReach (optional) ─────────────────────────────────────────────────
# Alerts reach an inReach through the reply link in Garmin's emails (no Garmin
# account or key needed).  INREACH_REPLY_ADDRESS is the aurora mailbox address
# the device sends to; leave it blank and inReach alerts are only logged.
# Every message the device receives counts against its Garmin plan.
INREACH_REPLY_ADDRESS=
# Garmin's reply-form host.  Undocumented; only change it to test against a
# local fake server.
INREACH_BASE_URL=https://inreach.garmin.com
INREACH_TIMEOUT_SECONDS=20

# ── Aurora mailbox (optional, IMAP) ───────────────────────────────────────────
# Polled for inReach messages: Y/N replies become observations, anything else
# is a pairing request (GUID logged + listed at GET /pairings).
# Set IMAP_HOST, IMAP_USER and IMAP_PASSWORD together, or leave all blank.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
# Use an app password (Gmail/Fastmail) rather than the account password.
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_POLL_SECONDS=120

# ── Failure notices (optional) ────────────────────────────────────────────────
# ntfy topic URL; a failed alert POSTs a one-line notice here.  Topics on
# ntfy.sh are public to anyone who guesses the name: pick a long random one.
NTFY_URL=

# ── Scheduling ────────────────────────────────────────────────────────────────
CHECK_INTERVAL_MINUTES=30
ALERT_COOLDOWN_HOURS=6

# Validate X-Twilio-Signature on the /sms/inbound webhook. Set to true in
# production (the webhook writes to the DB from a public URL).
TWILIO_VALIDATE_SIGNATURE=false

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///aurora.db

# ── External API keys ─────────────────────────────────────────────────────────
# Free key from https://portal.opentopography.org/requestApiKey
OPENTOPOGRAPHY_API_KEY=

# ── Factor weights (exponents in the weighted-product visibility model) ───────
# 1.0 = linear;  >1 = harsher penalty;  0.0 = disable factor entirely
WEIGHT_OVATION=1.0
WEIGHT_KP=0.5
WEIGHT_CLOUD=1.5
WEIGHT_AOD=1.0
WEIGHT_ELEV=0.3
WEIGHT_MOON=0.5
WEIGHT_LP=0.5
WEIGHT_PWV=0.3
WEIGHT_HORIZ=0.5
